* text=auto eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff2 binary

# Byte hashes are verified at startup. Preserve original line endings.
vendor/MediaCrawler/** -text
vendor/patches/baseline/** -text
# Patch payloads include original CRLF and blank context lines.
vendor/patches/workbench-*.patch -text whitespace=-blank-at-eol,cr-at-eol
